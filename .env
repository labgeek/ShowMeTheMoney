# Credentials for `statisticallydoomed.py --alert`. Keep this file out of source control.
# Values already in the real environment win over anything set here.

# Default jurisdiction for --place and for a first run of the window.
LOTTERY_PLACE=Florida

LOTTERY_GMAIL=some@email.com

# A Gmail app password (16 chars, no spaces) from https://myaccount.google.com/apppasswords
# Your normal Google password will not work.
LOTTERY_GMAIL_APP_PASSWORD="XXXX XXXX XXXX XXXX"

# Where the alert goes. An email address, or a carrier SMS gateway like 5551234567@vtext.com
LOTTERY_SMS_TO=some@email.com
